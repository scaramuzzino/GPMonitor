# Copia questo file in ".env" (stessa cartella) e personalizza.
# .env NON va committato: contiene la TUA configurazione (in .gitignore).

# Server da monitorare: nome=utente@host separati da virgola.
# host = IP o hostname raggiungibile in SSH. Puoi anche lasciarlo vuoto e
# aggiungere i server dalla dashboard (Config).
MON_HOSTS=srv1=root@10.0.0.1,srv2=user@10.0.0.2

# Indirizzo:porta su cui esporre la web. Tienila su rete fidata (loopback/VPN):
# NON esporla direttamente su internet.
MON_BIND=127.0.0.1:8888

MON_INTERVAL=15
MON_RETENTION_HOURS=48

# Scansione nmap (agentless)
MON_NMAP=1
MON_NMAP_INTERVAL_HOURS=6
MON_NMAP_TOP_PORTS=1000
MON_NMAP_DEEP=0
# vulners (CPE->CVE): 1 interroga vulners.com via internet (NON piu' on-premise). Default 0.
MON_NMAP_VULN=0
MON_NMAP_VULN_CAP=0

# Destinatario di report/avvisi email (modificabile anche da Config)
MON_REPORT_EMAIL=
